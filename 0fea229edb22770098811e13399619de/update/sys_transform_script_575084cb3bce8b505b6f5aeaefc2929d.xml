        <script><![CDATA[(function runTransformScript(source, map, log, target) {

	var config = new GlideRecord(
		'x_druva_druva_configuration'
	);

	config.addQuery('key', 'channelType');
	config.setLimit(1);
	config.query();

	if (config.next()) {
		var channelType = config.getValue('value');

		if (channelType) {
			target.setValue(
				'contact_type',
				channelType
			);
		}
	}

})(source, map, log, target);]]></script>
