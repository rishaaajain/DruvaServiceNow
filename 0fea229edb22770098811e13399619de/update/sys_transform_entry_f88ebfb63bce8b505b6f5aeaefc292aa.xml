        <source_script><![CDATA[answer = (function transformEntry(source) {
	var resourceName = source.getValue('resourcename');

	if (!resourceName) {
		return '';
	}

	var ciGr = new GlideRecord('cmdb_ci');
	ciGr.addQuery('name', resourceName);
	ciGr.setLimit(1);
	ciGr.query();

	if (ciGr.next()) {
		return ciGr.getUniqueValue();
	}

	gs.info(
		'[Druva] No matching Configuration Item found for resource: ' +
		resourceName
	);

	return '';
})(source);]]></source_script>
