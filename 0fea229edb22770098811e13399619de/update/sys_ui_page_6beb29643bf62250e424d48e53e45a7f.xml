        .mt-3 { margin-top: 1rem; }
        .mb-3 { margin-bottom: 1rem; }
    </style>

    <!-- Header Macro -->
    <g:macro_invoke macro="x_druva_druva_HeaderMacro" />
	
	<section style="background-color: white; padding: 10px 0;"></section>

    <!-- Title Section -->
    <section class="container-fluid" style="background-color:#0f294b; padding: 40px 0;">
        <h1 style="color:white; text-align:center;">Druva Privacy Statement for Druva's ServiceNow App</h1>
    </section>

    <!-- Content Section -->
    <section class="container mt-4 mb-4">
        <div class="row">
            <div class="col-md-12">
                <p>
                    This Druva App for ServiceNow is designed to automatically create a ServiceNow ticket
based on Customer's configurations. The Druva App does not pull any data from the
ServiceNow environment. Instead, the Druva App for ServiceNow enables ServiceNow
to pull Druva performance metadata from Druva's environment in order to create a
ServiceNow ticket. For example if a Druva backup fails, the app will pull Druva's
metadata about the failed backup and will create a ServiceNow ticket for that incident.
                </p>
				<p>
				For more details on Druva's privacy practices, please visit <a href="https://www.druva.com/privacy-policy" target="_blank" rel="noopener noreferrer" style="margin-left: 5px;"> https://www.druva.com/privacy-policy.</a>
				</p>
				<p>
				Last updated: July 21, 2025
				</p>
            </div>
        </div>
    </section>

    <!-- Footer Macro -->
    <g:macro_invoke macro="x_druva_druva_FooterMacro" />

</j:jelly>
